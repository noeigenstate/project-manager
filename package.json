{
  "name": "project-grid",
  "productName": "Project Grid",
  "version": "0.3.8",
  "description": "多个项目、多个真实终端，Codex 完成后一眼可见。",
  "author": "Project Grid",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/noeigenstate/project-manager.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "build": "node scripts/build-ssh-askpass.cjs && tsc --noEmit && vite build",
    "test": "node scripts/build-ssh-askpass.cjs && node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:sessions": "node scripts/session-smoke.mjs",
    "test:workspace": "node scripts/workspace-smoke.mjs",
    "test:motion": "node scripts/focus-motion-smoke.mjs",
    "test:completion": "node scripts/completion-smoke.mjs",
    "dist": "node -e \"require('electron')\" && npm run build && electron-builder --win --x64 --publish never",
    "pack": "node -e \"require('electron')\" && npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "local.projectgrid.desktop",
    "productName": "Project Grid",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "integration",
        "to": "integration"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "noeigenstate",
        "repo": "project-manager"
      }
    ],
    "nsis": {
      "artifactName": "Project-Grid-Setup-${version}-x64.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Grid",
      "deleteAppDataOnUninstall": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "artifactName": "Project-Grid-${version}-win-x64.${ext}"
    }
  }
}
